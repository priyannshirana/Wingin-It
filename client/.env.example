# Client env (§A3). Copy to .env.local for local overrides.
# WebSocket base without the room code; empty = same origin /ws (proxied by Vite to :8000).
VITE_WS_URL=
# REST + clips origin; empty = same origin (proxied by Vite).
VITE_API_URL=
# 1 = compile the dev routes (/dev/split, /dev/scene, /dev/cinematic) and dev tooling.
VITE_DEV_MODE=1
# Dev server only: where Vite proxies /api, /ws and /clips (docker compose: http://server:8000).
# VITE_PROXY_TARGET=http://localhost:8000
# Dev server only: content folder (docker compose: /content).
# CONTENT_DIR=../content
