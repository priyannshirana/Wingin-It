{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.85",
        "--browser", "chrome",
        "--isolated",
        "--viewport-size", "1440,900",
        "--caps", "vision",
        "--grant-permissions", "microphone",
        "--output-dir", ".playwright-mcp"
      ]
    }
  }
}
